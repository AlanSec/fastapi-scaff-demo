# 数据库配置
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=  # 必须设置，无默认值
POSTGRES_DB=aigc_db

# 安全配置（必须设置）
SECRET_KEY=  # 必须设置，用于JWT签名，建议使用 openssl rand -hex 32 生成
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# 刷新令牌配置
REFRESH_TOKEN_EXPIRE_DAYS=30  # 刷新令牌有效期30天

# 登录限制配置
MAX_LOGIN_ATTEMPTS=5  # 最大登录尝试次数
LOGIN_LOCKOUT_MINUTES=30  # 锁定时间（分钟）

# 管理员配置（必须设置）
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=  # 必须设置，无默认值
ADMIN_IS_SUPERUSER=true

# SMTP邮件配置（用于发送验证邮件和密码重置邮件）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=  # 应用专用密码
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=FastAPI App

# SD WebUI配置
SD_WEBUI_NODES=[{"name": "node1", "url": "http://localhost:7860", "api_key": "", "weight": 1}]
SD_WEBUI_TIMEOUT=60

# 存储配置
MEDIA_ROOT=./media
GALLERY_PATH=./media/gallery

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 日志配置
LOG_LEVEL=INFO
