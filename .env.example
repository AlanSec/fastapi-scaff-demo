# 运行环境
ENVIRONMENT=development  # development / production（生产环境必须显式设置 SECRET_KEY）

# 数据库（生产建议 PostgreSQL：postgresql+asyncpg://user:pass@host:5432/db）
DATABASE_URL=sqlite+aiosqlite:///./test.db

# 限流存储（本地 Redis；不可用时自动降级为内存实现）
REDIS_URL=redis://localhost:6379/0

# 安全配置（必须设置）
SECRET_KEY=  # 用于JWT签名，建议使用 openssl rand -hex 32 生成
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 登录限流
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# 服务启动配置（python main.py 使用）
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true  # 开发热重载；生产环境建议 false

# CORS 白名单（逗号分隔，按需添加前端域名）
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# 邮箱验证（开启后未验证邮箱的用户不能登录）
REQUIRE_EMAIL_VERIFICATION=false

# 管理员配置（必须设置）
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=  # 必须设置且满足密码强度（8位以上，含大小写和数字）
ADMIN_IS_SUPERUSER=true
